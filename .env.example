# ---------------------------------------------------------------------------
# Grand Theft Solana (GTS) — environment template
# Copy this file to `.env.local` and fill in values as needed.
#
# IMPORTANT: The game runs with ZERO configuration out of the box. If you leave
# the Supabase variables empty it uses an in-memory store so `npm run dev` just
# works. Provide Supabase credentials to enable persistence + multi-user play.
# ---------------------------------------------------------------------------

# --- Supabase (optional) ---------------------------------------------------
# Project URL, e.g. https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key (safe for the browser).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — SERVER ONLY. Used by API routes to write authoritatively.
# Never expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Solana ----------------------------------------------------------------
# Network for the wallet adapter: 'mainnet-beta' | 'devnet' | 'testnet'
NEXT_PUBLIC_SOLANA_NETWORK=devnet
# Optional custom RPC endpoint (defaults to the public cluster URL).
NEXT_PUBLIC_SOLANA_RPC=

# --- Admin -----------------------------------------------------------------
# Passphrase for the /admin control room. Defaults to "gts-admin" if unset.
ADMIN_PASSWORD=gts-admin
